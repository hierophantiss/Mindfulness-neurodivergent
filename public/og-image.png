<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600&amp;family=Playfair+Display:ital,wght@1,500&amp;display=swap');
    </style>
    
    <!-- Neurodiversity Rainbow Gradient -->
    <linearGradient id="rainbow" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#FF3B30" />
      <stop offset="20%" stop-color="#FF9500" />
      <stop offset="40%" stop-color="#FFCC00" />
      <stop offset="60%" stop-color="#4CD964" />
      <stop offset="80%" stop-color="#5AC8FA" />
      <stop offset="100%" stop-color="#5856D6" />
    </linearGradient>

    <!-- Deep Glow -->
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="15" result="blur" />
      <feComponentTransfer in="blur" result="glow1">
        <feFuncA type="linear" slope="0.6"/>
      </feComponentTransfer>
      <feMerge>
        <feMergeNode in="glow1"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>

  <!-- Background exactly matching our app color-bg -->
  <rect width="1200" height="630" fill="#0f1117" />
  
  <!-- Faint decorative background axis -->
  <path d="M 600,0 L 600,630" stroke="#d4d4d8" stroke-width="1" stroke-dasharray="8 12" opacity="0.05" />
  <path d="M 0,315 L 1200,315" stroke="#d4d4d8" stroke-width="1" stroke-dasharray="8 12" opacity="0.05" />

  <!-- Neurodivergent Text -->
  <text x="600" y="160" 
        font-family="'Inter', sans-serif" 
        font-size="38" 
        font-weight="600" 
        letter-spacing="24" 
        fill="#d4d4d8" 
        text-anchor="middle"
        style="text-transform: uppercase;">
    Neurodivergent
  </text>

  <!-- Mathematical Infinity Symbol with smooth tangents -->
  <path d="M 350 315 C 350 190, 520 190, 600 315 C 680 440, 850 440, 850 315 C 850 190, 680 190, 600 315 C 520 440, 350 440, 350 315 Z"
        fill="none" 
        stroke="url(#rainbow)" 
        stroke-width="20" 
        stroke-linecap="round" 
        stroke-linejoin="round" 
        filter="url(#glow)"/>

  <!-- Mindfulness Text -->
  <text x="600" y="520" 
        font-family="'Playfair Display', serif" 
        font-size="64" 
        font-style="italic" 
        letter-spacing="6" 
        fill="#1D9E75" 
        text-anchor="middle">
    mindfulness
  </text>
</svg>
