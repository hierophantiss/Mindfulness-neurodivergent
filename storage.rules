rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow read access to anyone (public assets)
      allow read: if true;
      
      // Only allow the admin to write/delete
      allow write: if request.auth != null && 
        request.auth.token.email.lower() == 'bairaktaris.theodoros@gmail.com';
    }
  }
}
